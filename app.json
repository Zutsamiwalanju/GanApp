{
  "expo": {
    "name": "GanApp",
    "slug": "ganapp",
    "scheme": "ganapp",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9FBFA",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ganapp.app"
    },
    "android": {
      "package": "com.ganapp.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-bg.png",
        "monochromeImage": "./assets/adaptive-mono.png",
        "backgroundColor": "#087F70"
      },
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#087F70"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GanApp uses your camera to take a live photo of the spot you are pinging. Gallery uploads are not allowed.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GanApp uses your location to show what is happening near you and to place your pings on the map."
        }
      ]
    ]
  }
}
